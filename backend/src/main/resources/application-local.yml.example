# 复制为 application-local.yml，或直接用环境变量 / 系统属性覆盖
# 启动示例：
#   mvn spring-boot:run -Dspring-boot.run.profiles=local

app:
  datasource:
    mysql:
      jdbc-url: jdbc:mysql://127.0.0.1:3306/vis4srd?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
      username: your_mysql_user
      password: your_mysql_password
    postgres:
      jdbc-url: jdbc:postgresql://127.0.0.1:5432/mental_health
      username: postgres
      password: your_pg_password
  jwt:
    secret: replace_me_in_local_env
